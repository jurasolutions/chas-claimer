# Crew QA screenshots and downloads stay local.
.scratch/*/qa/

# Real clinic exports never enter this public repo. Only the synthetic mock data is committed.
*.clinic.sqlite
*.clinic.db
clinic-exports/

# D1 exports of the desk hold health data (sealed and masked, but still the clinic's). Keep them in
